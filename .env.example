# URL backend yang bisa diakses dari browser (dipakai saat build frontend)
# Pakai IP LAN (bukan localhost) supaya dashboard bisa dibuka dari HP/device lain di jaringan yang sama
# Port di host (ubah kalau bentrok dengan service lain)
FRONTEND_PORT=5555
BACKEND_PORT=8765

# Port harus sama dengan BACKEND_PORT
BACKEND_PUBLIC_URL=http://192.168.1.100:8765

# Login dashboard (1 admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_ini
JWT_SECRET=ganti_dengan_string_acak_panjang
